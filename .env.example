# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=ollama          # ollama | openai | anthropic | openrouter | deepseek

OLLAMA_MODEL=qwen3.6:27b    # ~17 GB. Less VRAM (<16 GB)? use qwen3:14b
OLLAMA_NUM_CTX=8192          # context window; too small = the model loses its instructions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CANDIDATE_GENDER=neutral     # male | female | neutral
MIN_FIT=5                    # skip vacancies where best resume scores below this (0-10)
AUTO_SUBMIT=0                # 1 = click the final "Откликнуться"
FOREIGN_APPLY=remote          # вакансии в другой стране: remote = откликаться только на удалённые, always, never
